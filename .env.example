# Valores fictícios. Copie para .env (ignorado pelo Git).
UC_CATALOG=hidro_mg
# Opcional: caminho do volume raw (padrão: /Volumes/<catálogo>/raw/arquivos)
# UC_RAW_VOLUME=/Volumes/hidro_mg/raw/arquivos

# Databricks (Free Edition: só compute serverless)
DATABRICKS_HOST=https://exemplo.cloud.databricks.com
# Autenticação preferida: OAuth via `make db-auth` (sem token no arquivo).
# Só use token se o OAuth não funcionar: DATABRICKS_TOKEN=troque-por-seu-token
DATABRICKS_SERVERLESS_COMPUTE_ID=auto

# ANA HidroWebService (acesso pendente de aprovação)
ANA_API_USER=seu-usuario
ANA_API_PASSWORD=sua-senha
